rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return (data.uid == null || data.uid == request.auth.uid) 
        && (data.email == null || (data.email is string && data.email.size() <= 100))
        && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 100))
        && (data.careerField == null || (data.careerField is string && data.careerField.size() <= 50))
        && (data.onboardingScore == null || data.onboardingScore is int)
        && (data.diagnosticCompleted == null || data.diagnosticCompleted is bool)
        && (data.isPremium == null || data.isPremium is bool)
        && (data.createdAt == null || data.createdAt is timestamp)
        && (data.updatedAt == null || data.updatedAt is timestamp);
    }

    function isValidCertificate(data) {
      return data.keys().hasAll(['id', 'title'])
        && data.id is string && data.id.size() <= 100
        && data.title is string && data.title.size() <= 200
        && (data.date == null || data.date is timestamp)
        && (data.issuer == null || (data.issuer is string && data.issuer.size() <= 100));
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'title'])
        && data.id is string && data.id.size() <= 100
        && data.title is string && data.title.size() <= 200
        && (data.description == null || (data.description is string && data.description.size() <= 1000))
        && (data.tech == null || (data.tech is string && data.tech.size() <= 200))
        && (data.link == null || (data.link is string && data.link.size() <= 500));
    }

    function isValidTask(data) {
      return data.keys().hasAll(['id', 'title', 'completed'])
        && data.id is string && data.id.size() <= 100
        && data.title is string && data.title.size() <= 200
        && data.completed is bool
        && (data.target == null || (data.target is string && data.target.size() <= 100))
        && (data.timestamp == null || data.timestamp is timestamp);
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'message', 'read'])
        && data.id is string && data.id.size() <= 100
        && data.message is string && data.message.size() <= 500
        && data.read is bool
        && (data.type == null || (data.type is string && data.type.size() <= 50))
        && (data.timestamp == null || data.timestamp is timestamp);
    }

    function isValidSticker(data) {
      return data.keys().hasAll(['id', 'name'])
        && data.id is string && data.id.size() <= 100
        && data.name is string && data.name.size() <= 100
        && (data.icon == null || (data.icon is string && data.icon.size() <= 50))
        && (data.date == null || data.date is timestamp);
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['role', 'text'])
        && data.role in ['user', 'ai']
        && data.text is string && data.text.size() <= 5000
        && (data.timestamp == null || data.timestamp is timestamp);
    }

    function isValidAssessment(data) {
      return data.keys().hasAll(['type', 'score', 'timestamp'])
        && data.type in ['diagnostic', 'contest', 'subtopic']
        && data.score is int
        && (data.totalQuestions == null || data.totalQuestions is int)
        && (data.accuracy == null || data.accuracy is string)
        && (data.analysis == null || (data.analysis is string && data.analysis.size() <= 2000));
    }

    function isValidLearningProgress(data) {
      return data.keys().hasAll(['topicId', 'completed'])
        && data.topicId is string && data.topicId.size() <= 100
        && data.completed is bool
        && (data.subtopicId == null || (data.subtopicId is string && data.subtopicId.size() <= 100))
        && (data.lastAccessed == null || data.lastAccessed is timestamp);
    }

    function isValidRecruiter(data) {
      return data.keys().hasAll(['companyName'])
        && data.companyName is string && data.companyName.size() <= 200
        && (data.industry == null || (data.industry is string && data.industry.size() <= 100))
        && (data.verified == null || data.verified is bool)
        && (data.subscriptionLevel == null || (data.subscriptionLevel is string && data.subscriptionLevel.size() <= 50));
    }

    function isValidJob(data) {
      return data.keys().hasAll(['title', 'companyId', 'postedAt'])
        && data.title is string && data.title.size() <= 200
        && data.companyId is string && data.companyId.size() <= 128
        && data.postedAt is timestamp
        && (data.description == null || (data.description is string && data.description.size() <= 5000))
        && (data.requirements == null || data.requirements is list)
        && (data.salary == null || (data.salary is string && data.salary.size() <= 100));
    }

    // --- Match Rules ---

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /recruiters/{recruiterId} {
      allow get: if isOwner(recruiterId);
      allow create: if isOwner(recruiterId) && isValidRecruiter(incoming()) && incoming().verified == false;
      allow update: if isOwner(recruiterId) && isValidRecruiter(incoming())
                       && (incoming().diff(existing()).affectedKeys().hasOnly(['companyName', 'industry', 'subscriptionLevel'])
                           || (incoming().verified == existing().verified));
    }

    match /jobs/{jobId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidId(jobId) && isValidJob(incoming());
      allow update, delete: if isVerified() && isValidJob(incoming()) 
                               && (exists(/databases/$(database)/documents/recruiters/$(request.auth.uid)) 
                                   || existing().companyId == request.auth.uid);
    }
  }
}
